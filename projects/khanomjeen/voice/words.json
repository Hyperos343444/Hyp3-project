{
 "duration": 71.36291666666666,
 "segments": [
  {
   "line": 1,
   "part": 0,
   "text": "ขนมจีนน้ำยาสองร้าน สูตรเดียวกัน จากคลิปยูทูบคลิปเดียวกัน",
   "t0": 0.0,
   "t1": 3.8321666666666667
  },
  {
   "line": 1,
   "part": 1,
   "text": "ร้านหนึ่งขาย 30 บาท อีกร้านขาย 50 แต่คิวยาวกว่า",
   "t0": 4.3821666666666665,
   "t1": 7.8408125
  },
  {
   "line": 2,
   "part": 0,
   "text": "ต่างกันแค่ป้าย ร้านที่สองเขียนว่า เจ้าเก่า 50 ปี ใส่ชามดินเผา รองใบตอง",
   "t0": 8.220812500000001,
   "t1": 13.079833333333333
  },
  {
   "line": 3,
   "part": 0,
   "text": "ปี 2008 นักวิจัยให้คนชิมไวน์ในเครื่องสแกนสมอง",
   "t0": 13.459833333333334,
   "t1": 16.967666666666666
  },
  {
   "line": 3,
   "part": 1,
   "text": "ไวน์ตัวเดียวกัน พอบอกว่าขวดละ 90 ดอลลาร์ สมองส่วนที่รับรู้ความอร่อยทำงานมากกว่าตอนบอกว่า 10 ดอลลาร์",
   "t0": 17.517666666666667,
   "t1": 24.187
  },
  {
   "line": 4,
   "part": 0,
   "text": "ราคาไม่ได้แค่บอกว่าแพง",
   "t0": 24.567,
   "t1": 26.269666666666666
  },
  {
   "line": 4,
   "part": 1,
   "text": "มันบอกสมองล่วงหน้าว่า ต้องอร่อย",
   "t0": 26.819666666666667,
   "t1": 28.734375
  },
  {
   "line": 5,
   "part": 0,
   "text": "อีกการทดลอง คนที่ซื้อเครื่องดื่มบำรุงสมองในราคาลด แก้โจทย์ได้น้อยกว่าคนที่จ่ายเต็มราคา ทั้งที่ดื่มของเดียวกัน",
   "t0": 29.114375,
   "t1": 35.63635416666666
  },
  {
   "line": 6,
   "part": 0,
   "text": "แล้วคำว่า 50 ปีล่ะ? งานวิจัยปี 2010 พบว่า คนให้คะแนนช็อกโกแลตดีกว่า แค่บอกว่ามันวางขายมานานกว่า",
   "t0": 36.016354166666666,
   "t1": 43.329395833333336
  },
  {
   "line": 7,
   "part": 0,
   "text": "ส่วนคิวยาว คือหลักฐานทางสังคม",
   "t0": 43.70939583333334,
   "t1": 45.74808333333334
  },
  {
   "line": 7,
   "part": 1,
   "text": "เห็นคนอื่นต่อแถว ก็เชื่อว่าต้องดี แถวเลยยิ่งยาว",
   "t0": 46.29808333333334,
   "t1": 49.314375000000005
  },
  {
   "line": 8,
   "part": 0,
   "text": "ความอร่อยจึงเกิดทั้งในปาก",
   "t0": 49.69437500000001,
   "t1": 51.238916666666675
  },
  {
   "line": 8,
   "part": 1,
   "text": "และในหัว",
   "t0": 51.78891666666667,
   "t1": 52.536687500000006
  },
  {
   "line": 9,
   "part": 0,
   "text": "ถ้าคุณเป็นคนขาย สูตรจะเหมือนคนอื่นก็ได้ แต่เรื่องเล่าต้องเป็นของคุณ",
   "t0": 52.91668750000001,
   "t1": 56.880791666666674
  },
  {
   "line": 10,
   "part": 0,
   "text": "บอกว่าน้ำยาเคี่ยวกี่ชั่วโมง ปลามาจากไหน ใครเป็นคนทำ",
   "t0": 57.26079166666668,
   "t1": 60.57020833333334
  },
  {
   "line": 10,
   "part": 1,
   "text": "ใส่ชามที่ดูตั้งใจ แล้วตั้งราคาให้สมกับความตั้งใจนั้น",
   "t0": 61.12020833333334,
   "t1": 64.86912500000001
  },
  {
   "line": 11,
   "part": 0,
   "text": "แต่อย่าเขียนว่า 50 ปี ถ้าเพิ่งเปิดเมื่อวาน",
   "t0": 65.249125,
   "t1": 67.69052083333334
  },
  {
   "line": 11,
   "part": 1,
   "text": "เพราะลูกค้ายอมจ่ายให้เรื่องเล่า แต่ไม่เคยให้อภัยคนโกหก",
   "t0": 68.24052083333333,
   "t1": 71.36291666666666
  }
 ],
